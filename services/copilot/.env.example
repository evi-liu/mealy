# Server-only. Use an organization-approved credential, never a browser variable.
COPILOT_GITHUB_TOKEN=
# GitHub username returned by SDK authentication, not an email address.
COPILOT_EXPECTED_LOGIN=
# Exact model ID available to the configured Copilot account. No default.
COPILOT_MODEL=
# Match COPILOT_GATEWAY_TOKEN in Supabase; generate at least 32 random bytes.
MEALY_GATEWAY_TOKEN=
# Only this household may spend the configured Copilot entitlement.
MEALY_HOUSEHOLD_ID=
HOST=127.0.0.1
PORT=8787
